# RotatorProxy example configuration.
# Copy this file to config.toml and adjust values for your environment.

# The single local proxy port. It auto-detects HTTP/HTTPS CONNECT and SOCKS5.
listen = "127.0.0.1:7890"

# Files or directories to scan for outbound proxies.
# Directories are scanned non-recursively and files are processed in sorted order.
proxy_dirs = ["./proxies"]

# Maximum outbound proxies to try for one inbound request when connection setup fails.
# If no proxies are loaded, RotatorProxy connects directly.
max_retries = 10

# Timeout for connecting to a target or outbound proxy.
connect_timeout_ms = 10000

# Timeout for fetching subscription URLs found in proxy source files.
subscription_timeout_ms = 15000

# User-Agent sent when fetching subscription URLs.
subscription_user_agent = "RotatorProxy/0.1"

# Default log level. RUST_LOG overrides this value.
log_level = "info"

# HTTP or HTTPS endpoint used to test outbound proxy liveness.
# Pick an endpoint that is stable and reachable from your network; any 2xx/3xx
# response is considered healthy.
health_check_url = "http://example.com/"

# A node must pass within this many attempts to enter the active rotation pool.
health_check_attempts = 3

# Timeout for each health-check attempt.
health_check_timeout_ms = 10000

# Maximum number of proxy nodes checked at the same time.
health_check_concurrency = 32

# When health_check_url uses https://, keep certificate verification enabled by
# default. Set this to true only for a private/self-signed health endpoint.
health_check_tls_skip_verify = false

# Runtime connection failures before an active node enters cooldown.
runtime_failure_threshold = 3

# How long a runtime-failing node is skipped before it can be tried again.
cooldown_seconds = 300

# Local time for the daily full reload + health check.
# The service keeps serving with the previous active pool until the new pool is ready.
daily_refresh_time = "04:00"

# Enable the optional Mihomo sidecar fallback for Clash node types that the
# in-process backend cannot currently dial. Most common TCP nodes are handled
# without Mihomo: vmess, vless, trojan, hysteria2/hy2, snell, anytls, Reality
# TLS, client-fingerprint/uTLS, and Shadowsocks with supported built-in
# plugins. Keep this off unless you need fallback protocols such as tuic,
# wireguard/wg, mieru, ssh, or ssr.
mihomo_enabled = false

# Optional explicit Mihomo binary path. If unset, RotatorProxy checks PATH for
# mihomo, clash-meta, then clash.
# mihomo_binary = "/usr/local/bin/mihomo"

# If Mihomo fallback is enabled and no binary is configured or found in PATH,
# automatically download the latest Mihomo release on Linux amd64/arm64. Other
# platforms should provide a binary through mihomo_binary or PATH.
mihomo_auto_download = false

# Work directory for downloaded Mihomo binaries and generated generation configs.
# This path is runtime state and is ignored by Git in the default repository.
mihomo_work_dir = ".rotator-proxy/mihomo"

# Log level written into generated Mihomo configs.
mihomo_log_level = "warning"

# Maximum time to wait for a newly spawned Mihomo generation to open all local
# listeners before its nodes are skipped for that refresh.
mihomo_startup_timeout_ms = 10000

# After a successful refresh swaps in a new pool, keep the previous Mihomo
# generation alive for this long so existing connections can drain.
mihomo_retire_grace_seconds = 300
